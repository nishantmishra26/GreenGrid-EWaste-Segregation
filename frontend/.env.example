# GreenGrid v2 Frontend Environment Variables
# Copy this file to .env.local for local development (not committed to git)

# API base URL (defaults to Vite proxy in development)
# VITE_API_BASE_URL=http://localhost:8000

# Enable/disable features
# VITE_ENABLE_CHAT=true
# VITE_ENABLE_CENTERS=true
# VITE_ENABLE_GRADCAM=true